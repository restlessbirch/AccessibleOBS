#!/bin/sh
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/scan_secrets.ps1 -Staged
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/scan_secrets.ps1 -Staged
else
  echo "PowerShell is required for scripts/scan_secrets.ps1" >&2
  exit 1
fi
