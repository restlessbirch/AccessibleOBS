/target/
/bin/*.exe
/dist/
# Вся папка целиком, а не только *.log: при суточной ротации к имени
# добавляется дата, и файл называется host.log.2026-08-17 — под шаблон с
# расширением он не подходит и полез бы в репозиторий.
/logs/
/config/secrets/
/third_party/installers/
.env
.env.*
/config/*.local.json
*.dpapi
*.key
*.pem
*.pdb
*.zip
